{
  "name": "@workspace/api-server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "knowledge:migrate": "tsx scripts/migrate-knowledge.ts",
    "test": "tsx --test src/*.test.ts",
    "test:limiter:required": "CC_AI_REQUIRE_REDIS_TESTS=1 tsx --test src/ai-limiter.test.ts src/ai-limiter-transport.test.ts",
    "test:http-limiter:required": "CC_HTTP_REQUIRE_REDIS_TESTS=1 tsx --test src/request-limits.test.ts src/client-security.test.ts",
    "test:limiter:staging": "tsx scripts/verify-ai-limiter.ts",
    "typecheck:limiter": "tsc -p tsconfig.verify.json --noEmit",
    "dev": "export NODE_ENV=development && pnpm run build && pnpm run start",
    "build": "node ./build.mjs",
    "start": "node --enable-source-maps ./dist/index.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1150.0",
    "@azure/identity": "^4.13.3",
    "@azure/storage-blob": "^12.34.0",
    "@google-cloud/storage": "^8.4.0",
    "@workspace/api-zod": "workspace:*",
    "@workspace/db": "workspace:*",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "docxtemplater": "^3.71.0",
    "drizzle-orm": "catalog:",
    "express": "^5.3.0",
    "express-rate-limit": "8.7.1",
    "fast-xml-parser": "^5.11.2",
    "google-auth-library": "^11.3.0",
    "multer": "^2.4.0",
    "pdfjs-dist": "^6.4.299",
    "pino": "^9.14.0",
    "pino-http": "^10.5.0",
    "pizzip": "^3.3.0",
    "saxes": "6.0.0",
    "yauzl": "^3.4.0",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/multer": "^2.3.0",
    "@types/node": "catalog:",
    "@types/yauzl": "^3.4.0",
    "esbuild": "0.28.2",
    "esbuild-plugin-pino": "^2.3.3",
    "pino-pretty": "^13.1.3",
    "thread-stream": "3.1.0",
    "tsx": "catalog:"
  }
}
