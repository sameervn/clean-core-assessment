# Authoritative client runtime template. Copy outside the repository; NEVER commit.
# Placeholders are NOT usable credentials. See DEERE-GATEWAY.md for client handoff.
# Optional startup input (inject this path externally, not inside the file itself):
# CC_RUNTIME_ENV_FILE=/etc/clean-core/.env
# Existing environment injection wins over this file, including empty values.
POSTGRES_PASSWORD=replace-with-random-url-safe-local-password
DATABASE_URL=postgresql://app:REPLACE@db.example.com:5432/clean_core
SESSION_SECRET=replace-with-at-least-32-random-characters
CC_BOOTSTRAP_PASSWORD=replace-with-unique-14-to-128-character-password
NODE_ENV=production
PORT=8080
LOG_LEVEL=info
CC_STATIC_DIR=/app/public
CC_SCHEMA_BOOTSTRAP=false
CC_REPLICA_COUNT=1
CC_COOKIE_INSECURE=false
CC_DB_POOL_MAX=10
CC_DB_ALLOW_PLAINTEXT=false
# CC_DB_CA_FILE=/etc/db-ca/ca.pem
CC_KNOWLEDGE_STORAGE=local
PRIVATE_OBJECT_DIR=/documents/private
CC_STORAGE_LOCAL_DIR=/data
# CC_S3_BUCKET=client-private-versioned-documents
# CC_S3_REGION=eu-west-1
# CC_S3_ENDPOINT=https://s3.eu-west-1.amazonaws.com
# CC_AZURE_STORAGE_URL=https://client.blob.core.windows.net
# CC_AZURE_STORAGE_CONTAINER=documents
# PUBLIC_OBJECT_SEARCH_PATHS=/bucket/public
CC_AI_ENABLED=false
CC_AI_AUTH_MODE=local
CC_AI_LIMITER=local
# Deere backend configuration (does NOT change frontend login).
# Fill the three REPLACE values below, then set CC_AI_ENABLED=true and restart.
# Never put the populated client secret in this example file or commit it.
CC_AI_PROVIDER=deere-gateway
CC_AI_MODEL=REPLACE-WITH-APPROVED-GATEWAY-MODEL-ID
AI_GATEWAY_REGISTRATION_ID=clean-core-assessment-tool
AI_GATEWAY_CLIENT_ID=0oa2v9rn39jCKiiUn0h8
AI_GATEWAY_CLIENT_SECRET=REPLACE-WITH-CLIENT-SECRET
AI_GATEWAY_BASE_URL=https://ai-gateway.deere.com
AI_GATEWAY_ISSUER=REPLACE-WITH-CONFIRMED-DEV-OR-PRODUCTION-ISSUER
# Dev: https://sso-dev.johndeere.com/oauth2/ausx8znnnrQpD7x0f0h7
# Production: https://sso.johndeere.com/oauth2/aushh24tmyH9xSbQ21t7
# Only the documented OpenAI-compatible protocol/route is currently supported.
# Confirm the exact Claude model ID AND compatibility before enabling Claude.
AI_GATEWAY_PROTOCOL=openai-chat
AI_GATEWAY_ROUTE=/openai/chat/completions
# Alternative non-Deere deployments: change CC_AI_PROVIDER to openai or azure,
# change CC_AI_MODEL above, and configure the applicable variables below.
# No CC_AI_API_KEY is used in Deere mode.
# CC_AI_API_KEY=REPLACE
# CC_AI_ENDPOINT=https://api.openai.com
# CC_AI_API_VERSION=2024-10-21
# CC_AI_GATEWAY_PUBLIC_KEY=REPLACE-RSA-PUBLIC-KEY-PEM
# CC_AI_GATEWAY_ISSUER=https://gateway.example.com
# CC_AI_GATEWAY_AUDIENCE=clean-core
# CC_AI_LIMITER_URL=https://redis-rest.example.com
# CC_AI_LIMITER_TOKEN=REPLACE
# CC_AI_LIMITER_NAMESPACE=clean-core
# SDK-managed credentials: prefer projected workload identity, not static keys.
# AWS_ROLE_ARN=arn:aws:iam::123456789012:role/clean-core
# AWS_WEB_IDENTITY_TOKEN_FILE=/var/run/secrets/eks.amazonaws.com/serviceaccount/token
# AWS_ACCESS_KEY_ID=REPLACE
# AWS_SECRET_ACCESS_KEY=REPLACE
# AWS_SESSION_TOKEN=REPLACE
# AZURE_CLIENT_ID=00000000-0000-0000-0000-000000000000
# AZURE_TENANT_ID=00000000-0000-0000-0000-000000000000
# AZURE_FEDERATED_TOKEN_FILE=/var/run/secrets/azure/tokens/azure-identity-token
# GOOGLE_APPLICATION_CREDENTIALS=/etc/gcp/adc.json
# Build only: BASE_PATH=/, PORT=5173, NODE_ENV=production.
# Test-only and Replit-managed variables: see ENV-VARIABLES.md; do not copy to clients.
# BASE_PATH=/
# REPL_ID=platform-managed
# REPLIT_DEV_DOMAIN=platform-managed.replit.dev
# DEFAULT_OBJECT_STORAGE_BUCKET_ID=platform-managed
# CC_TEST_ACCOUNTS=false
# CC_TEST_KNOWLEDGE=false
# CC_TEST_REPORTS=false
# CC_AI_REQUIRE_REDIS_TESTS=0
# CLEAN_CORE_BASE_URL=http://localhost:80
# PLAYWRIGHT_CHROMIUM_EXECUTABLE_PATH=/repl/tools/bin/chromium
# SYNTHETIC_PASSWORD=REPLACE-DISPOSABLE-TEST-VALUE
# REDIS_CLI_BIN=redis-cli
# REDIS_SERVER_BIN=redis-server
# PATH=/usr/local/bin:/usr/bin:/bin
# NODE_TLS_REJECT_UNAUTHORIZED=1
# AZURE_CLIENT_SECRET=REPLACE
# AWS_CONTAINER_CREDENTIALS_FULL_URI=platform-injected
# AWS_CONTAINER_AUTHORIZATION_TOKEN_FILE=platform-injected
# CC_ENV_FILE=/absolute/path/to/compose-test.env
